[node name="HSeparator" type="HSeparator" parent="BonusesPanel/Center/Panel/Margin/VBox/Tabs/Bonusy"]

[node name="Tip" type="Label" parent="BonusesPanel/Center/Panel/Margin/VBox/Tabs/Bonusy"]
theme_override_font_sizes/font_size = 16
text = "Bonusy padají z poražených bugů a po 8 s zmizí. ČIPY z nepřátel utratíš v TERMINÁLU [E] u chodby po každé vlně, nebo za REROLL karet.\nOVERCLOCK (Shift): čím déle držíš, tím vyšší úroveň (I–III) – rychlejší pohyb a palba, ale víc tepla.\nREDLINE (80–100 %): +1 poškození a vyšší násobič skóre. Přehřátí = CRASH, zásah během crashe = konec!\nVENT (Q / kolečko): od 40 % tepla vypustíš všechno teplo jako výbuch páry – čím víc tepla, tím silnější.\nDASH (pravé myši / K): úskok s nesmrtelností, stojí teplo. Při overclocku zraní bugy."
custom_minimum_size = Vector2(700, 0)
autowrap_mode = 3
theme_override_colors/font_color = Color(0.7, 0.7, 0.7, 1)

